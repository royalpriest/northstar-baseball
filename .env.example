# NorthStar backend runtime.
# Use "production" in the deployed FastAPI service.
NORTHSTAR_ENV=development

# Development database. Production must provide a managed PostgreSQL URL.
NORTHSTAR_DATABASE_URL=postgresql+psycopg://northstar:northstar@localhost:5432/northstar

# CSV fallback is development-only. Production refuses to start data requests
# without NORTHSTAR_DATABASE_URL.
NORTHSTAR_PROFILE_PATH=reports/tables/hitter_profile_with_canada_2025.csv

# Comma-separated frontend origins allowed to call FastAPI directly.
# The current Next.js UI normally talks through its same-origin server proxy.
NORTHSTAR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API documentation and automatic schema creation default to true in
# development and false in production.
NORTHSTAR_ENABLE_DOCS=true
NORTHSTAR_AUTO_CREATE_SCHEMA=true

# Research pipeline data root.
NORTHSTAR_DATA_DIR=data
