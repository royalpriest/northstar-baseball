# When running Next.js by itself, point server-side requests at local FastAPI.
# Under Vercel Services, NORTHSTAR_API_URL is injected automatically by the
# web -> api service binding in ../vercel.json. Do not set it manually there.
NORTHSTAR_API_URL=http://127.0.0.1:8000

# Maximum time for server-rendered API calls and the browser proxy.
NORTHSTAR_API_TIMEOUT_MS=8000
